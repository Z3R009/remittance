<odoo>

    <record id="view_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.remittance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='wage']" position="after">

                <label for="pera" />
                <div class="o_row">
                    <field name="pera" class="oe_inline o_hr_narrow_field" nolabel="1" />
                </div>

                <label for="gross_earnings" />
                <div class="o_row">
                    <field name="gross_earnings" class="oe_inline o_hr_narrow_field" nolabel="1"
                        readonly="1" />
                </div>

                <label for="withholding_tax" />
                <div class="o_row">
                    <field name="withholding_tax" class="oe_inline o_hr_narrow_field" nolabel="1" />
                </div>

            </xpath>

        </field>
    </record>
</odoo>