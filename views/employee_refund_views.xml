<odoo>

    <record id="view_employee_refund_search" model="ir.ui.view">
        <field name="name">employee.refund.search</field>
        <field name="model">employee.refund</field>
        <field name="arch" type="xml">
            <search string="Search Refunds">
                <field name="employee_name" string="Employee" />
                <field name="payroll_month" />
                <field name="department_id" />
                <filter string="This Month" name="this_month"
                    domain="[('payroll_month','=', context_today().strftime('%Y-%m-01'))]" />
                <filter string="Last Month" name="last_month"
                    domain="[('payroll_month','=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01'))]" />
                <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}" />
                <filter string="Department" name="group_department"
                    context="{'group_by':'department_id'}" />
                <filter string="Payroll Month" name="group_month"
                    context="{'group_by':'payroll_month:month'}" />
            </search>
        </field>
    </record>

    <record id="view_employee_refund_list" model="ir.ui.view">
        <field name="name">employee.refund.list</field>
        <field name="model">employee.refund</field>
        <field name="arch" type="xml">
            <list string="Employee Refunds" default_order="payroll_month desc, employee_name asc">
                <field name="payroll_month" />
                <field name="employee_name" />
                <field name="department_id" />
                <field name="total_refund" />
            </list>
        </field>
    </record>

    <record id="view_employee_refund_form" model="ir.ui.view">
        <field name="name">employee.refund.form</field>
        <field name="model">employee.refund</field>
        <field name="arch" type="xml">
            <form string="Employee Refund">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" />
                        </h1>
                    </div>
                    <group col="4">
                        <field name="department_id" />
                        <field name="payroll_month" />
                    </group>

                    <group string="Audit Trail">
                        <field name="source_deduction_id" />
                        <field name="reason" />
                    </group>

                    <notebook>
                        <page string="GSIS">
                            <group col="2">
                                <field name="refund_mpl" />
                                <field name="refund_emergency_loan" />
                                <field name="refund_ps_overdeduction" />
                                <field name="refund_educ_loan" />
                                <field name="refund_policy_loan_reg" />
                                <field name="refund_mpl_lite" />
                                <field name="refund_rel" />
                                <field name="refund_gfal_2" />
                            </group>
                        </page>
                        <page string="HDMF/Pag-IBIG">
                            <group col="2">
                                <field name="refund_hdmf_mp2" />
                                <field name="refund_hdmf_mpl" />
                                <field name="refund_hdmf_calamity" />
                                <field name="refund_hdmf_hl" />
                                <field name="refund_hdmf_housing" />
                            </group>
                        </page>
                        <page string="Other">
                            <group col="2">
                                <field name="refund_dti_pf_loan" />
                                <field name="refund_lbp_dbp" />
                                <field name="refund_globe" />
                            </group>
                        </page>
                    </notebook>

                    <group>
                        <field name="total_refund" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_refund" model="ir.actions.act_window">
        <field name="name">Refunds</field>
        <field name="res_model">employee.refund</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_month': 1}</field>
    </record>

</odoo>