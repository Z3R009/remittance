<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- SEARCH VIEW -->
    <record id="view_employee_compensation_search" model="ir.ui.view">
        <field name="name">employee.compensation.search</field>
        <field name="model">employee.compensation</field>
        <field name="arch" type="xml">
            <search string="Search Compensation">
                <field name="employee_id" />
                <field name="department_id" />
                <field name="payroll_month" />
                <filter string="This Month" name="this_month"
                    domain="[('payroll_month','=', context_today().strftime('%Y-%m-01'))]" />
                <filter string="Last Month" name="last_month"
                    domain="[('payroll_month','=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01'))]" />
                <filter string="Locked" name="locked_only" domain="[('locked','=',True)]" />
                <filter string="Unlocked" name="unlocked_only" domain="[('locked','=',False)]" />
                <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}" />
                <filter string="Department"
                    name="group_department"
                    context="{'group_by': 'department_id'}" />
                <filter string="Payroll Month" name="group_month"
                    context="{'group_by':'payroll_month:month'}" />
            </search>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_employee_compensation_list" model="ir.ui.view">
        <field name="name">employee.compensation.list</field>
        <field name="model">employee.compensation</field>
        <field name="arch" type="xml">
            <list string="Employee Compensation" default_order="payroll_month desc, employee_id asc">
                <field name="payroll_month" />
                <field name="employee_id" />
                <field name="department_id" />
                <field name="basic_salary" />
                <field name="pera" />
                <field name="gross_earnings" readonly="1" />
                <field name="withholding_tax" />
                <field name="locked" />
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_employee_compensation_form" model="ir.ui.view">
        <field name="name">employee.compensation.form</field>
        <field name="model">employee.compensation</field>
        <field name="arch" type="xml">
            <form string="Employee Compensation">
                <header>
                    <button name="action_lock" type="object" string="Lock This Month"
                        class="btn-primary" invisible="locked" />
                    <button name="action_unlock" type="object" string="Unlock"
                        invisible="not locked" />
                    <button name="action_carry_forward" type="object"
                        string="Carry Forward to Next Month" class="btn-primary" />
                </header>
                <sheet>

                    <group>
                        <field name="employee_id" />
                        <field name="department_id" />
                        <field name="payroll_month" />
                        <field name="locked" />
                    </group>

                    <group string="Compensation">
                        <field name="basic_salary" readonly="locked" />
                        <field name="pera" readonly="locked" />
                        <field name="representation_allowance" readonly="locked" />
                        <field name="transportation_allowance" readonly="locked" />
                        <field name="gross_earnings" readonly="1" />
                        <field name="withholding_tax" readonly="locked" />
                    </group>

                </sheet>

                <chatter />

            </form>
        </field>
    </record>

</odoo>