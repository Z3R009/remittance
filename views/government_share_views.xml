<odoo>

    <record id="view_government_share_list" model="ir.ui.view">
        <field name="name">government.share.list</field>
        <field name="model">government.share</field>
        <field name="arch" type="xml">
            <list string="Government Share">
                <field name="payroll_month" />
                <field name="gs_gsis_rlip" />
                <field name="gs_philhealth" />
                <field name="gs_hdmf_cont1" />
            </list>
        </field>
    </record>

    <record id="view_government_share_form" model="ir.ui.view">
        <field name="name">government.share.form</field>
        <field name="model">government.share</field>
        <field name="arch" type="xml">
            <form string="Government Share">
                <sheet>
                    <group>
                        <field name="payroll_month" />
                    </group>
                    <notebook>
                        <page string="GSIS">
                            <group col="2">
                                <field name="gs_gsis_rlip" />
                                <field name="gs_gsis_conso_loan" />
                                <field name="gs_gsis_mpl_lite" />
                                <field name="gs_gsis_mpl" />
                                <field name="gs_gsis_emergency_loan" />
                                <field name="gs_gsis_computer_loan" />
                                <field name="gs_gsis_educ_loan" />
                                <field name="gs_gsis_policy_loan_reg" />
                                <field name="gs_gsis_policy_loan_opt" />
                                <field name="gs_gsis_opt_life_pre" />
                                <field name="gs_gsis_rel" />
                                <field name="gs_gsis_gfal_2" />
                            </group>
                        </page>
                        <page string="HDMF/Pag-IBIG">
                            <group col="2">
                                <field name="gs_hdmf_cont1" />
                                <field name="gs_hdmf_mp2" />
                                <field name="gs_hdmf_mpl" />
                                <field name="gs_hdmf_calamity_loan" />
                                <field name="gs_hdmf_housing" />
                            </group>
                        </page>
                        <page string="Other">
                            <group col="2">
                                <field name="gs_philhealth" />
                                <field name="gs_dti_pf_cont" />
                                <field name="gs_dti_pf_loan" />
                                <field name="gs_mdbf" />
                                <field name="gs_dti_eu_dues" />
                                <field name="gs_dti_eu_hmo" />
                                <field name="gs_lbp_dbp" />
                                <field name="gs_globe" />
                                <field name="gs_amaphil" />
                                <field name="gs_whc" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_government_share" model="ir.actions.act_window">
        <field name="name">Government Share</field>
        <field name="res_model">government.share</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_payroll_summary_wizard_form" model="ir.ui.view">
        <field name="name">payroll.summary.wizard.form</field>
        <field name="model">payroll.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Payroll Summary">
                <group>
                    <field name="payroll_month" />
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_summary_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Summary</field>
        <field name="res_model">payroll.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_payroll_summary_adjustment_list" model="ir.ui.view">
        <field name="name">payroll.summary.adjustment.list</field>
        <field name="model">payroll.summary.adjustment</field>
        <field name="arch" type="xml">
            <list string="Summary Adjustments">
                <field name="payroll_month" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_payroll_summary_adjustment_form" model="ir.ui.view">
        <field name="name">payroll.summary.adjustment.form</field>
        <field name="model">payroll.summary.adjustment</field>
        <field name="arch" type="xml">
            <form string="Summary Adjustment">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. DelaCruz (RLIP)" />
                        <field name="payroll_month" />
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="category_key" />
                            <field name="amount" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll_summary_adjustment" model="ir.actions.act_window">
        <field name="name">Summary Adjustments</field>
        <field name="res_model">payroll.summary.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_remittance_amount_list" model="ir.ui.view">
        <field name="name">remittance.amount.list</field>
        <field name="model">remittance.amount</field>
        <field name="arch" type="xml">
            <list string="Remittance">
                <field name="payroll_month" />
                <field name="rm_gsis_rlip" />
                <field name="rm_philhealth" />
                <field name="rm_hdmf_cont1" />
            </list>
        </field>
    </record>

    <record id="view_remittance_amount_form" model="ir.ui.view">
        <field name="name">remittance.amount.form</field>
        <field name="model">remittance.amount</field>
        <field name="arch" type="xml">
            <form string="Remittance">
                <sheet>
                    <group>
                        <field name="payroll_month" />
                    </group>
                    <notebook>
                        <page string="GSIS">
                            <group col="2">
                                <field name="rm_gsis_rlip" />
                                <field name="rm_gsis_conso_loan" />
                                <field name="rm_gsis_mpl_lite" />
                                <field name="rm_gsis_mpl" />
                                <field name="rm_gsis_emergency_loan" />
                                <field name="rm_gsis_computer_loan" />
                                <field name="rm_gsis_educ_loan" />
                                <field name="rm_gsis_policy_loan_reg" />
                                <field name="rm_gsis_policy_loan_opt" />
                                <field name="rm_gsis_opt_life_pre" />
                                <field name="rm_gsis_rel" />
                                <field name="rm_gsis_gfal_2" />
                            </group>
                        </page>
                        <page string="HDMF/Pag-IBIG">
                            <group col="2">
                                <field name="rm_hdmf_cont1" />
                                <field name="rm_hdmf_mp2" />
                                <field name="rm_hdmf_mpl" />
                                <field name="rm_hdmf_calamity_loan" />
                                <field name="rm_hdmf_housing" />
                            </group>
                        </page>
                        <page string="Other">
                            <group col="2">
                                <field name="rm_philhealth" />
                                <field name="rm_dti_pf_cont" />
                                <field name="rm_dti_pf_loan" />
                                <field name="rm_mdbf" />
                                <field name="rm_dti_eu_dues" />
                                <field name="rm_dti_eu_hmo" />
                                <field name="rm_lbp_dbp" />
                                <field name="rm_globe" />
                                <field name="rm_amaphil" />
                                <field name="rm_whc" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_remittance_amount" model="ir.actions.act_window">
        <field name="name">Remittance</field>
        <field name="res_model">remittance.amount</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>