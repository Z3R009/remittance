<odoo>

    <record id="view_payroll_print_wizard_form" model="ir.ui.view">
        <field name="name">payroll.print.wizard.form</field>
        <field name="model">payroll.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print PACSVAL / PER OO / JEV">
                <group>
                    <field name="payroll_month" />
                </group>
                <group string="JEV">
                    <group>
                        <field name="jev_no" placeholder="e.g. 101-2026-09-019" />
                        <field name="jev_date" />
                        <field name="dv_no" placeholder="e.g. PS-26-09-001" />
                        <field name="alobs_no" placeholder="e.g. PS-26-09-001" />
                    </group>
                    <group>
                        <field name="jev_prepared_by" />
                        <field name="jev_prepared_by_position" />
                        <field name="jev_certified_by" />
                        <field name="jev_certified_by_position" />
                    </group>
                </group>
                <group string="PER OO">
                    <field name="oo_prepared_by" />
                    <field name="oo_prepared_by_position" />
                </group>
                <footer>
                    <button name="action_export_pacsval_xlsx" type="object"
                        string="Export PACSVAL (Excel)" class="btn-secondary" />
                    <button name="action_print_pacsval" type="object" string="Print PACSVAL"
                        class="btn-primary" />
                    <button name="action_print_per_oo" type="object" string="Print PER OO"
                        class="btn-primary" />
                    <button name="action_print_jev" type="object" string="Print JEV"
                        class="btn-primary" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_print_wizard" model="ir.actions.act_window">
        <field name="name">Print PACSVAL / PER OO / JEV</field>
        <field name="res_model">payroll.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_payroll_print"
        name="PACSVAL / PER OO / JEV"
        parent="menu_remittance_root"
        action="action_payroll_print_wizard"
        sequence="65" />

</odoo>