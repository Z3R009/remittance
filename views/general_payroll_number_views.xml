<odoo>

    <record id="view_general_payroll_number_list" model="ir.ui.view">
        <field name="name">general.payroll.number.list</field>
        <field name="model">general.payroll.number</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="department_id" />
                <field name="payroll_month" />
                <field name="payroll_no" />
            </list>
        </field>
    </record>

    <record id="action_general_payroll_number" model="ir.actions.act_window">
        <field name="name">Saved Payroll Numbers</field>
        <field name="res_model">general.payroll.number</field>
        <field name="view_mode">list</field>
    </record>

</odoo>