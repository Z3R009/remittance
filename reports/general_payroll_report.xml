<odoo>

    <!-- Landscape A4, minimal margins to fit ~29 columns -->
    <record id="paperformat_general_payroll" model="report.paperformat">
        <field name="name">General Payroll</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Reusable single value + optional loan paid/term badge -->
    <template id="gp_value">
        <t t-if="value">
            <t t-if="value_changed">
                <span style="background-color:yellow;">
                    <t t-esc="'{:,.2f}'.format(value)" />
                </span>
            </t>
            <t t-else="">
                <t t-esc="'{:,.2f}'.format(value)" />
            </t>
        </t>
        <t t-else="">-</t>
        <br />
        <t t-if="badge_changed">
            <span style="background-color:yellow; color:#900; font-size:6px;">
                <t t-esc="paid" />/<t t-esc="term" />
            </span>
        </t>
        <t t-else="">
            <span style="color:#900; font-size:6px;">
                <t t-esc="paid" />/<t t-esc="term" />
            </span>
        </t>
    </template>

    <template id="report_general_payroll_document">
        <t t-set="recs" t-value="docs" />
        <t t-set="today_str"
            t-value="'%s/%s/%s' % (datetime.date.today().month, datetime.date.today().day, datetime.date.today().year)" />
        <t t-set="grand_total_net" t-value="sum(recs.mapped('net_pay_payslip'))" />

        <div style="font-family: Arial, sans-serif; font-size:8px;">

            <table style="width:100%;">
                <tr>
                    <td style="width:60%; font-size:8px;"> Entity Name: <b>
                            <u>
                                <t t-esc="'DEPARTMENT OF TRADE AND INDUSTRY XII'" />
                            </u>
                        </b><br />
                        Fund Cluster: <b>
                            <u>
                                <t t-esc="'REGULAR AGENCY FUND (01101101)'" />
                            </u>
                        </b>
                    </td>
                    <td style="text-align:right; font-size:8px;">
                        DTI12-FA-SF005
                    </td>
                </tr>
            </table>

            <div style="text-align:center; margin-top:4px;">
                <div style="font-weight:bold; font-size:12px;">GENERAL PAYROLL</div>
                <div style="font-weight:bold;">
                    DEPARTMENT OF TRADE AND INDUSTRY - REGION 12
                </div>
                <div style="font-weight:bold;">
                    <t
                        t-esc="recs[:1].employee_id.department_id.get_top_parent().name if recs and recs[:1].employee_id.department_id else ''" />
                </div>
                <div style="font-weight:bold;"> FOR THE MONTH OF <t
                        t-esc="recs[:1].payroll_month.strftime('%B %Y').upper() if recs else ''" />
                </div>
            </div>

            <div style="margin-top:4px; font-size:8px;">
                We acknowledge receipt of cash shown opposite our name as full compensation for
                services
                rendered for the period covered.
            </div>

            <table style="width:100%; border-collapse:collapse; margin-top:4px; font-size:7px;"
                border="1">
                <thead>
                    <tr style="text-align:center; font-weight:bold;">
                        <td rowspan="3" style="width:8%;">NAME</td>
                        <td colspan="4">COMPENSATIONS</td>
                        <td colspan="21">DEDUCTIONS</td>
                        <td colspan="2">NET TAKE HOME PAY</td>
                        <td rowspan="3">SIGNATURE</td>
                    </tr>
                    <tr style="text-align:center; font-weight:bold;">
                        <td colspan="4"></td>
                        <td colspan="9">G S I S</td>
                        <td colspan="4">HDMF/PAG-IBIG</td>
                        <td colspan="7">OTHER DEDUCTIONS</td>
                        <td rowspan="2">TOTAL<br />DEDUCTIONS</td>
                        <td colspan="2"></td>
                    </tr>
                    <tr style="text-align:center; font-weight:bold;">
                        <td>BASIC<br />Salary</td>
                        <td>PERA</td>
                        <td>GROSS<br />EARNINGS</td>
                        <td>W/HOLDING<br />TAX</td>

                        <td>RLIP</td>
                        <td>CONSOLOAN<br />MPL</td>
                        <td>EML<br />CMPL</td>
                        <td>EDUC'L<br />LOAN</td>
                        <td>SOLAR<br />LOAN</td>
                        <td>POLICY LOAN<br />REG/OPT</td>
                        <td>OPT_LIFE/PRE<br />MPL LITE</td>
                        <td>R.E.L.</td>
                        <td>GFAL II</td>

                        <td>CONT.I</td>
                        <td>CONT.II</td>
                        <td>MPL<br />Calamity</td>
                        <td>LOT/<br />Housing</td>

                        <td>PHIC<br />CONT</td>
                        <td>DTI-PF Cont.<br />MDBF</td>
                        <td>DTI-PF Loan/<br />DTI-EU Dues</td>
                        <td>LBP/DBP Loan<br />DTI-EU HMO</td>
                        <td>AMAPHIL</td>
                        <td>WHC</td>
                        <td>GLOBE</td>

                        <td>1-15</td>
                        <td>16-31</td>
