                <t t-set="value" t-value="o.gsis_policy_loan_reg" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Policy Loan (Optional)</span>
                        <span style="padding-left:58px;">
                            <t t-esc="o.gsis_policy_loan_opt_paid" />/<t
                                t-esc="o.gsis_policy_loan_opt_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_policy_loan_opt" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- OPT Life Premium</span>
                        <span style="padding-left:76px;">
                            <t t-esc="o.gsis_opt_life_pre_paid" />/<t
                                t-esc="o.gsis_opt_life_pre_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_opt_life_pre" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:block; padding-left:40px;">- R.E.L.
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_rel" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- GFAL II</span>
                        <span style="padding-left:128px;">
                            <t t-esc="o.gsis_gfal_2_paid" />/<t
                                t-esc="o.gsis_gfal_2_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_gfal_2" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
