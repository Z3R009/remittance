                </td>
            </tr>
            <tr>
                <td> Amount Due (<t t-esc="o.payroll_month.strftime('%B').upper()" /> 16-30, <t
                        t-esc="o.payroll_month.strftime('%Y')" />) </td>
                <td style="text-align:right;">
                    <t t-esc="'{:,.2f}'.format(o.total_net_2nd or 0)" />
                </td>
            </tr>
        </table>

        <div style="margin-top:16px; font-size:10px;"> Certified Correct: <div
                style="margin-top:20px; font-weight:bold;">NEIL ANTHONY
                T.
                MORALA</div>
            <div>Accountant
                III</div>
        </div>

    </template>

    <!-- ============================================================ -->
    <!-- SINGLE PAYSLIP - one per page, portrait, bound to Take Home Pay -->
    <!-- ============================================================ -->
    <template id="report_payslip_document">
        <t t-foreach="docs" t-as="rec">
            <div class="page"
                style="font-family: Arial, sans-serif; font-size:10px; border:1px solid #000; padding:6px;">
                <t t-call="remittance.payslip_slip_content">
                    <t t-set="o" t-value="rec" />
                </t>
            </div>
            <p t-if="not rec_last" style="page-break-after: always;" />
        </t>
    </template>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-call="remittance.report_payslip_document" />
        </t>
    </template>

    <record id="action_report_payslip" model="ir.actions.report">
        <field name="name">Payslip</field>
        <field name="model">take.home.pay</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">remittance.report_payslip</field>
        <field name="report_file">remittance.report_payslip</field>
        <field name="print_report_name">'Payslip - %s - %s' % (object.employee_id.name,
            object.payroll_month)</field>
        <field name="paperformat_id" ref="paperformat_payslip" />
        <field name="binding_model_id" ref="model_take_home_pay" />
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================================ -->
    <!-- BULK PAYSLIPS - 3 per page, landscape, bound to Compensation -->
    <!-- Select multiple Compensation records -> Print Payslip -->
    <!-- ============================================================ -->
    <template id="report_payslip_bulk_document">
        <t t-set="thp_list" t-value="[]" />
        <t t-foreach="docs" t-as="comp">
            <t t-set="thp"
                t-value="env['take.home.pay'].search([('employee_compensation_id', '=', comp.id)], limit=1)" />
            <t t-if="thp">
                <t t-set="thp_list" t-value="thp_list + [thp]" />
            </t>
        </t>
        <t t-foreach="range(0, len(thp_list), 3)" t-as="batch_start">
            <div class="page"
                style="width:100%; height:200mm; overflow:hidden; page-break-inside:avoid;">
                <table
                    style="width:100%; height:200mm; border-collapse:collapse; table-layout:fixed;">
                    <tr>
                        <t t-foreach="thp_list[batch_start:batch_start + 3]" t-as="rec">
                            <td style="vertical-align:top; padding:0; height:200mm;">
                                <div
                                    style="
        width:95mm;
        height:200mm;
        overflow:hidden;
        box-sizing:border-box;
        border:1px solid #000;
        padding:6px;
        font-family:Arial, sans-serif;
        font-size:9px;
    ">
                                    <t t-call="remittance.payslip_slip_content">
                                        <t t-set="o" t-value="rec" />
                                    </t>
                                </div>
                            </td>
                        </t>
                    </tr>
                </table>
            </div>
            <p t-if="not batch_start_last" style="page-break-after: always;" />
        </t>
    </template>

    <template id="report_payslip_bulk">
        <t t-call="web.html_container">
            <t t-call="remittance.report_payslip_bulk_document" />
        </t>
    </template>

    <record id="action_report_payslip_bulk" model="ir.actions.report">
        <field name="name">Print Payslip</field>
        <field name="model">employee.compensation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">remittance.report_payslip_bulk</field>
        <field name="report_file">remittance.report_payslip_bulk</field>
        <field name="print_report_name">'Payslips'</field>
        <field name="paperformat_id" ref="paperformat_payslip_bulk" />
        <field name="binding_model_id" ref="model_employee_compensation" />
