<odoo>

    <!-- Narrow slip-sized paper, single payslip per page -->
    <record id="paperformat_payslip" model="report.paperformat">
        <field name="name">Payslip</field>
        <field name="default" eval="False" />
        <field name="format">custom</field>
        <field name="page_height">210</field>
        <field name="page_width">95</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- A4 landscape, 3 payslips side by side per page -->
    <record id="paperformat_payslip_bulk" model="report.paperformat">
        <field name="name">Payslip (3-per-page)</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Reusable row: Label | Amount (or "-" if zero) -->
    <template id="payslip_line">
        <tr>
            <td style="padding:1px 4px; font-size:10px;">
                <t t-esc="label" />
            </td>
            <td style="padding:1px 4px; font-size:10px; text-align:right; white-space:nowrap;">
                <t t-if="value">
                    <t t-esc="'{:,.2f}'.format(value)" />
                </t>
                <t t-else="">-</t>
            </td>
        </tr>
    </template>

    <!-- ============================================================ -->
    <!-- REUSABLE SLIP BODY - the actual payslip content, no page wrap -->
    <!-- Used by both the single-record report and the 3-per-page one -->
    <!-- ============================================================ -->
    <template id="payslip_slip_content">

        <div style="text-align:center; line-height:1.2;">
            <div style="font-size:10px; margin-top:2px;">Department of Trade and Industry</div>
            <div style="font-size:10px; margin-top:2px;">Regional Office 12</div>
            <div style="font-size:12px; font-weight:bold; margin-top:2px; margin-bottom:5px;">PAYROLL
                PAYMENT
                SLIP</div>
        </div>

        <table style="width:100%; font-size:10px;">
            <tr>
                <td style="width:35%;">
                    <b>Office/Division</b>
                </td>
                <td>
                    <t
                        t-esc="o.employee_id.department_id.get_top_parent().name if o.employee_id.department_id else ''" />
                </td>
            </tr>
            <tr>
                <td>
                    Pay Period
                </td>
                <td> FOR THE MONTH OF <t
                        t-esc="o.payroll_month.strftime('%B %Y').upper()" />
                </td>
            </tr>
        </table>

        <hr style="border:0; border-top:2px solid #000;" />

        <table style="width:100%; font-size:10px; margin-top:4px;">
            <tr>
                <td style="width:35%; ">
                    Employee's Name
                </td>
                <td
                    style="font-size:12px; font-weight:bold; text-transform:uppercase; text-decoration:underline; white-space:nowrap;">
                    <t t-esc="o.employee_id.name" />
                </td>
                <td style="width:20%;">
                    <b>Employee No.</b>
                </td>
                <td style="text-decoration:underline;">
                    <t t-esc="o.employee_id.employee_number or ''" />
                </td>
            </tr>
            <tr>
                <td>
                    Position
                </td>
                <td colspan="3"
                    style="text-decoration:underline; white-space:nowrap; font-size:9px;">
                    <t t-esc="o.employee_id.job_title or (o.employee_id.job_id.name or '')" />
                </td>
            </tr>
        </table>

        <table style="width:100%; border-collapse:collapse; margin-top:6px;">

            <tr>
                <td
                    style="text-align:left; font-weight:bold; font-size:10px; padding-left:40px; ">
                    ***Earnings***
                </td>
                <td
                    style="font-weight:bold; text-align:right; font-size:10px; padding-right:30px">
                    Monthly</td>
            </tr>

            <t t-call="remittance.payslip_line">
                <t t-set="label">Salary Basic</t>
                <t t-set="value" t-value="o.basic_salary" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">Additional Compensation</t>
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">Personal Econ. Relief Allowance</t>
                <t t-set="value" t-value="o.pera" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:block; padding-left:40px;">
                        Representation Allowance (RA)
                    </span>
                </t>
                <t t-set="value" t-value="o.representation_allowance" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:block; padding-left:40px;">
                        Transportation Allowance (TA)
                    </span>
                </t>
                <t t-set="value" t-value="o.transportation_allowance" />
            </t>

            <tr>
                <td style="padding-left:25px; font-size:10px; border-bottom:1px solid #000;">
                    Gross Earnings
                </td>
                <td style="text-align:right; font-size:10px; border-bottom:1px solid #000;">
                    <t t-esc="'{:,.2f}'.format(o.gross_earnings_payslip or 0)" />
                </td>
            </tr>

            <tr>
                <td colspan="2"
                    style="text-align:left; font-weight:bold; font-size:10px; padding-left:40px; margin-top:15px;">
                    ***Deductions***
                </td>
            </tr>

            <t t-call="remittance.payslip_line">
                <t t-set="label">BIR Withholding Tax</t>
                <t t-set="value" t-value="o.withholding_tax" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">GSIS Contribution</t>
                <t t-set="value" t-value="o.gsis_rlip" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="">HDMF - Contribution I</span>
                    </span>
                </t>
                <t t-set="value" t-value="o.hdmf_cont1" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:block; padding-left:40px;">
                        - Contribution II
                    </span>
                </t>
                <t t-set="value" t-value="o.hdmf_mp2" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">PHIC Contribution</t>
                <t t-set="value" t-value="o.philhealth" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="">GSIS - Consolidated Loan/MPL</span>
                        <span style="padding-left:60px;">
                            <t t-esc="o.gsis_conso_loan_paid" />/<t
                                t-esc="o.gsis_conso_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_conso_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- MPL</span>
                        <span style="padding-left:140px;">
                            <t t-esc="o.gsis_mpl_paid" />/<t
