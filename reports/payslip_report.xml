                        <span style="padding-left:82px;">
                            <t t-esc="o.hdmf_mpl_paid" />/<t
                                t-esc="o.hdmf_mpl_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.hdmf_mpl" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Calamity Loan</span>
                        <span style="padding-left:95px;">
                            <t t-esc="o.hdmf_calamity_loan_paid" />/<t
                                t-esc="o.hdmf_calamity_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.hdmf_calamity_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Housing Loan</span>
                        <span style="padding-left:100px;">
                            <t t-esc="o.hdmf_housing_paid" />/<t
                                t-esc="o.hdmf_housing_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.hdmf_housing" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">DTI-PF Contribution</t>
                <t t-set="value" t-value="o.dti_pf_cont" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="">DTI-PF Loan</span>
                        <span style="padding-left:151px;">
                            <t t-esc="o.dti_pf_loan_paid" />/<t
                                t-esc="o.dti_pf_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.dti_pf_loan" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">DTI-MDBF Contribution</t>
                <t t-set="value" t-value="o.mdbf" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">DTI-EU Monthly Dues</t>
                <t t-set="value" t-value="o.dti_eu_dues" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">DTI-HMO</t>
                <t t-set="value" t-value="o.dti_eu_hmo" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- LBP Salary Loan</span>
                        <span style="padding-left:82px;">
                            <t t-esc="o.lbp_dbp_paid" />/<t
                                t-esc="o.lbp_dbp_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.lbp_dbp" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">GLOBE</t>
                <t t-set="value" t-value="o.globe" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="">WHC</span>
                        <span style="padding-left:185px;">
                            <t t-esc="o.whc_paid" />/<t
                                t-esc="o.whc_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.whc" />
            </t>
            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="">Amaphil</span>
                        <span style="padding-left:169px;">
                            <t t-esc="o.amaphil_paid" />/<t
                                t-esc="o.amaphil_term" />
