                <t t-set="value" t-value="o.gsis_emergency_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Computer Loan</span>
                        <span style="padding-left:89px;">
                            <t t-esc="o.gsis_computer_loan_paid" />/<t
                                t-esc="o.gsis_computer_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_computer_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Educational Loan</span>
                        <span style="padding-left:79px;">
                            <t t-esc="o.gsis_educ_loan_paid" />/<t
                                t-esc="o.gsis_educ_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_educ_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Solar Loan</span>
                        <span style="padding-left:111px;">
                            <t t-esc="o.gsis_solar_loan_paid" />/<t
                                t-esc="o.gsis_solar_loan_term" />
                        </span>
                    </span>
                </t>
                <t t-set="value" t-value="o.gsis_solar_loan" />
            </t>

            <t t-call="remittance.payslip_line">
                <t t-set="label">
                    <span style="display:flex; justify-content:space-between; width:100%;">
                        <span style="padding-left:40px;">- Policy Loan (Regular)</span>
                        <span style="padding-left:62px;">
                            <t t-esc="o.gsis_policy_loan_reg_paid" />/<t
